simple_reassignment:
       |
       | LABEL_1:
     1 |           MOVE                VREG 1, IMM 10
     2 |           MOVE                VREG 2, IMM 20
     3 |           RETURN

parameter_reassignment:
       |
       | LABEL_2:
     1 |           GET_PARAMETER       VREG 1, IMM 0
     2 |           MOVE                VREG 2, IMM 20
     3 |           RETURN

returning_value_from_a_function:
       |
       | LABEL_3:
     1 |           MOVE                VREG 1, IMM 10
     2 |           RETURN              VREG 1

returning_mutable_value_from_a_function:
       |
       | LABEL_4:
     1 |           MOVE                VREG 1, IMM 10
     2 |           MOVE                VREG 2, IMM 20
     3 |           MOVE                VREG 3, IMM 30
     4 |           RETURN              VREG 3

simple_conditional_assignment:
       |
       | LABEL_5:
     1 |           MOVE                VREG 1, IMM 10
       |
       | LABEL_6:
     2 |           JUMP                LABEL_7
       |
       | LABEL_7:
     3 |           PHI                 VREG 3, VREG 1
     4 |           RETURN              VREG 3

conditional_assignment_of_multiple_variables:
       |
       | LABEL_8:
     1 |           MOVE                VREG 1, IMM 10
     2 |           MOVE                VREG 5, IMM 11
       |
       | LABEL_9:
     3 |           MOVE                VREG 3, IMM 30
     4 |           JUMP                LABEL_10
       |
       | LABEL_10:
     5 |           PHI                 VREG 4, VREG 3
     6 |           PHI                 VREG 7, VREG 5
     7 |           ADD                 VREG 9, VREG 4, VREG 7
     8 |           RETURN              VREG 9

function_calls:
       |
       | LABEL_11:
     1 |           CALL                simple_reassignment
     2 |           CALL                VREG 1, returning_value_from_a_function
     3 |           MOVE                VREG 2, VREG 1
     4 |           CALL                parameter_reassignment, VREG 2
     5 |           CALL                VREG 3, returning_value_from_a_function
     6 |           RETURN              VREG 3
