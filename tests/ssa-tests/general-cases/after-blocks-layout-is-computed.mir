simple_reassignment:
       |
       | LABEL_1:
     1 |           MOVE                RAX, IMM 10
     2 |           MOVE                RAX, IMM 20
     3 |           RETURN

parameter_reassignment:
       |
       | LABEL_2:
     1 |           MOVE                RAX, IMM 20
     2 |           RETURN

returning_value_from_a_function:
       |
       | LABEL_3:
     1 |           MOVE                RAX, IMM 10
     2 |           RETURN

returning_mutable_value_from_a_function:
       |
       | LABEL_4:
     1 |           MOVE                RAX, IMM 10
     2 |           MOVE                RAX, IMM 20
     3 |           MOVE                RAX, IMM 30
     4 |           RETURN

simple_conditional_assignment:
       |
       | LABEL_5:
     1 |           MOVE                RAX, IMM 10
       |
       | LABEL_7:
     2 |           RETURN

conditional_assignment_of_multiple_variables:
       |
       | LABEL_8:
     1 |           MOVE                RAX, IMM 10
     2 |           MOVE                RAX, IMM 11
       |
       | LABEL_9:
     3 |           MOVE                RBX, IMM 30
       |
       | LABEL_10:
     4 |           ADD                 RAX, RBX, RAX
     5 |           RETURN

function_calls:
       |
       | LABEL_11:
     1 |           GROW_STACK          IMM 32
     2 |           CALL                simple_reassignment
     3 |           SHRINK_STACK        IMM 32
     4 |           GROW_STACK          IMM 32
     5 |           CALL                returning_value_from_a_function
     6 |           SHRINK_STACK        IMM 32
     7 |           MOVE                RCX, RAX
     8 |           GROW_STACK          IMM 32
     9 |           CALL                parameter_reassignment
    10 |           SHRINK_STACK        IMM 32
    11 |           GROW_STACK          IMM 32
    12 |           CALL                returning_value_from_a_function
    13 |           SHRINK_STACK        IMM 32
    14 |           RETURN
