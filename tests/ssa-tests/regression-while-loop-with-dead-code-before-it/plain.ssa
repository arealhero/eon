good_example:
     1 |           ASSIGN           VARIABLE a@1, CONSTANT s32 10
     2 |           JUMP             LABEL_1
       |
       |           PHI              VARIABLE a@2, VARIABLE a@1, VARIABLE a@3
     3 | LABEL_1:
     4 |           GREATER          VARIABLE <temp_1>@1, VARIABLE a@2, CONSTANT s32 0
     5 |           JUMP_IF_FALSE    LABEL_2, VARIABLE <temp_1>@1
     6 |           JUMP             LABEL_3
     7 | LABEL_3:
     8 |           SUBTRACT         VARIABLE <temp_2>@1, VARIABLE a@2, CONSTANT s32 1
     9 |           ASSIGN           VARIABLE a@3, VARIABLE <temp_2>@1
    10 |           JUMP             LABEL_1
    11 | LABEL_2:
    12 |           RETURN

bad_example:
     1 | LABEL_1:
     2 |           JUMP_IF_FALSE    LABEL_2, CONSTANT bool FALSE
     3 |           JUMP             LABEL_5
     4 | LABEL_5:
     5 |           JUMP             LABEL_1
     6 | LABEL_2:
     7 |           ASSIGN           VARIABLE a@1, CONSTANT s32 10
     8 |           JUMP             LABEL_3
       |
       |           PHI              VARIABLE a@2, VARIABLE a@1, VARIABLE a@3
     9 | LABEL_3:
    10 |           GREATER          VARIABLE <temp_1>@1, VARIABLE a@2, CONSTANT s32 0
    11 |           JUMP_IF_FALSE    LABEL_4, VARIABLE <temp_1>@1
    12 |           JUMP             LABEL_6
    13 | LABEL_6:
    14 |           SUBTRACT         VARIABLE <temp_2>@1, VARIABLE a@2, CONSTANT s32 1
    15 |           ASSIGN           VARIABLE a@3, VARIABLE <temp_2>@1
    16 |           JUMP             LABEL_3
    17 | LABEL_4:
    18 |           RETURN
