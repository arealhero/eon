unreachable_while_loop:
     1 | LABEL_1:
     2 |           JUMP             LABEL_2
     3 | LABEL_2:
     4 |           RETURN           CONSTANT s32 20

redundant_while_loop:
     1 | LABEL_1:
     2 |           JUMP             LABEL_3
     3 | LABEL_3:
     4 |           RETURN           CONSTANT s32 10

redundant_continue:
     1 |           ASSIGN           VARIABLE a@1, CONSTANT s32 10
     2 |           JUMP             LABEL_1
       |
       |           PHI              VARIABLE a@2, VARIABLE a@1, VARIABLE a@3
     3 | LABEL_1:
     4 |           GREATER          VARIABLE <temp_1>@1, VARIABLE a@2, CONSTANT s32 0
     5 |           JUMP_IF_FALSE    LABEL_2, VARIABLE <temp_1>@1
     6 |           JUMP             LABEL_3
     7 | LABEL_3:
     8 |           SUBTRACT         VARIABLE <temp_2>@1, VARIABLE a@2, CONSTANT s32 1
     9 |           ASSIGN           VARIABLE a@3, VARIABLE <temp_2>@1
    10 |           JUMP             LABEL_1
    11 | LABEL_2:
    12 |           RETURN

