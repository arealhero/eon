arithmetic_operations:
       |
       | LABEL_1:
     1 |           MOVE                VREG 3, IMM 6
     2 |           MOVE                VREG 5, IMM 5
     3 |           RETURN

non_trivial_conditional:
       |
       | LABEL_2:
     1 |           MOVE                RAX, IMM 1
     2 |           RETURN

then_branch_elimination:
       |
       | LABEL_3:
       |
       | LABEL_4:
     1 |           MOVE                RAX, IMM 20
     2 |           RETURN

else_branch_elimination:
       |
       | LABEL_5:
     1 |           JUMP                LABEL_6
       |
       | LABEL_6:
     2 |           MOVE                RAX, IMM 10
     3 |           RETURN
